1493.Longest subarray of 1's after deleting one element
class Solution {
    public int longestSubarray(int[] nums) {
        int left = 0;
        int zcnt = 0;
        int currlen = 0;
        int maxlen = 0;
        for(int right = 0; right < nums.length; right++) {
            if(nums[right] == 0) {
                zcnt++;
            }
            while(zcnt > 1) {
                if(nums[left] == 0){
                    zcnt--;
                }
                left++;
            }
            currlen = right - left;
            maxlen = Math.max(maxlen, currlen);
        }
        return maxlen;     
    }
}
